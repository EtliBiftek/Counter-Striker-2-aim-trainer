{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetik Aim",
  "version": "0.1.0",
  "identifier": "app.tetik.aim",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tetik Aim",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "CS2 hissiyatında aim antrenmanı",
    "category": "Game"
  }
}
